# 1. Extract even numbers

numbers = [10, 15, 20, 25, 30, 35]
even_numbers = [num for num in numbers if num % 2 == 0]
print("Even numbers:", even_numbers)


# 2. Square numbers

numbers = [1, 2, 3, 4, 5]
squares = [num ** 2 for num in numbers]
print("Squares:", squares)


# 3. Convert words to uppercase

words = ["python", "machine", "learning", "ai"]
uppercase_words = [word.upper() for word in words]
print("Uppercase:", uppercase_words)


# 4. Create dictionary from two lists

names = ["Alice", "Bob", "Charlie"]
marks = [85, 90, 78]

students = {name: mark for name, mark in zip(names, marks)}
print("Students:", students)


# 5. Filter numbers greater than 50

numbers = [10, 25, 55, 70, 45, 90, 30]
large_numbers = [num for num in numbers if num > 50]
print("Greater than 50:", large_numbers)